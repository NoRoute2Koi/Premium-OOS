# Premium UI Effects & Blur for OriginOS 6
ro.launcher.blur.appLaunch=1
ro.surface_flinger.supports_background_blur=1

# Performance Optimization for Adreno / OriginOS 6
persist.debug.blurlevel_4=false
debug.blur.dynamic.frameRate=true
persist.debug.qs_enable_hardware_optimize=true
debug.hwui.vivo_blur_dualKawase=true
debug.hwui.vivo_blur_opt=true
persist.blur.GPU.enable=true
persist.blur.GPU.minlevel=70
persist.blur.GPU.duration=1000

# Spacesystem and blur HAL properties
ro.vendor.vivo.software.spacesystem=1
ro.vendor.vivo.software.spacesystem:level=1
ro.vendor.vivo.software.spacesystem:version=3
ro.vendor.vivo.software.spacesystem:vivo-support=1
ro.vendor.vivo.software.spacesystem:is_support_zygote=1

ro.vendor.vivo.software.spacesystem.borderlight=1
ro.vendor.vivo.software.spacesystem.borderlight:version=3
ro.vendor.vivo.software.spacesystem.borderlight:vivo-support=1
ro.vendor.vivo.software.spacesystem.borderlight:is_support_zygote=1

ro.vendor.vivo.software.nativeblur=1
ro.vendor.vivo.software.nativeblur:vivo-support=1
ro.vendor.vivo.software.nativeblur:is_support_zygote=1

ro.vendor.vivo.software.motionblur=1
ro.vendor.vivo.software.motionblur:vivo-support=1
ro.vendor.vivo.software.motionblur:is_support_zygote=1

ro.vendor.vivo.software.asyncanimboost=1
ro.vendor.vivo.software.asyncanimboost:vivo-support=1
ro.vendor.vivo.software.asyncanimboost:is_support_zygote=1

ro.vendor.vivo.software.realtimeblur=1
ro.vendor.vivo.software.realtimeblur:vivo-support=1
ro.vendor.vivo.software.realtimeblur:is_support_zygote=1

ro.vendor.vivo.software.vglasseffect=1
ro.vendor.vivo.software.vglasseffect:vivo-support=1
ro.vendor.vivo.software.vglasseffect:is_support_zygote=1

ro.vendor.vivo.software.windowdeformblur=1
ro.vendor.vivo.software.windowdeformblur:support_blur=1
ro.vendor.vivo.software.windowdeformblur:min_blur_radius=8
ro.vendor.vivo.software.windowdeformblur:min_blur_radius_temp=24
ro.vendor.vivo.software.windowdeformblur:vivo-support=1
ro.vendor.vivo.software.windowdeformblur:is_support_zygote=1

ro.vendor.vivo.software.systemeffect=1
ro.vendor.vivo.software.systemeffect:system_effect_type=0
ro.vendor.vivo.software.systemeffect:vivo-support=1
ro.vendor.vivo.software.systemeffect:is_support_zygote=1
